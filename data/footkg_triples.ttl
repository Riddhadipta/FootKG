footres:Club_Porto a footkg:ClubTeam ;
    rdfs:label "FC Porto"@en ;
    footkg:managedBy footres:Manager_SimoneInzaghi .

footres:Event_002_Rodri_ProgressivePass a footkg:ProgressivePass ;
    footkg:directlyPrecedes footres:Event_003_Lewis_HalfSpaceCarry ;
    footkg:originatesInZone footres:Zone8_MidCentral ;
    footkg:performedBy footres:Player_Rodri ;
    footkg:terminatesInZone footres:Zone7_MidRightHalfSpace .

footres:Event_003_Lewis_HalfSpaceCarry a footkg:Pass ;
    footkg:directlyPrecedes footres:Event_004_Doku_CutbackCross ;
    footkg:originatesInZone footres:Zone7_MidRightHalfSpace ;
    footkg:performedBy footres:Player_RicoLewis ;
    footkg:terminatesInZone footres:Zone11_AttRightFlank .

footres:Event_004_Doku_CutbackCross a footkg:ProgressivePass ;
    footkg:originatesInZone footres:Zone11_AttRightFlank ;
    footkg:performedBy footres:Player_JeremyDoku ;
    footkg:terminatesInZone footres:Zone13_AttZone14 .

footres:Formation_3_2_5_InPoss a footkg:Formation ;
    rdfs:label "3-2-5 In-Possession Shape"@en ;
    footkg:leavesVulnerableZone footres:Zone1_DefRightFlank,
        footres:Zone5_DefLeftFlank .

