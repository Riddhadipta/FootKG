footres:Role_BallPlayingDefender a footkg:BallPlayingDefender ;
    rdfs:label "Ball-Playing Defender"@en ;
    footkg:inPossessionZone footres:Zone3_DefCentral ;
    footkg:outOfPossessionZone footres:Zone3_DefCentral .

footres:Role_PressingForward a footkg:PressingForward ;
    rdfs:label "Pressing Forward"@en ;
    footkg:inPossessionZone footres:Zone17_BoxCentral ;
    footkg:outOfPossessionZone footres:Zone13_AttZone14 .

footres:Zone16_BoxRight a footkg:CentralCorridor,
        footkg:PitchZone ;
    rdfs:label "Opponent 6-yard Box Right"@en ;
    footkg:zoneDescription "Opponent 6-yard Box Right"^^xsd:string .

footres:Zone18_BoxLeft a footkg:CentralCorridor,
        footkg:PitchZone ;
    rdfs:label "Opponent 6-yard Box Left"@en ;
    footkg:zoneDescription "Opponent 6-yard Box Left"^^xsd:string .

footkg:AnchorMan a owl:Class ;
    rdfs:label "Anchor Man / Pivot (Busquets archetype)"@en ;
    rdfs:subClassOf footkg:MidfieldRole .

footkg:BallPlayingDefender a owl:Class ;
    rdfs:label "Ball-Playing Central Defender"@en ;
    rdfs:subClassOf footkg:DefensiveRole .

footkg:BoxToBoxMidfielder a owl:Class ;
    rdfs:label "Box-to-Box Midfielder"@en ;
    rdfs:subClassOf footkg:MidfieldRole .

footkg:DeepLyingPlaymaker a owl:Class ;
    rdfs:label "Deep-Lying Playmaker (Regista)"@en ;
    rdfs:subClassOf footkg:MidfieldRole .

footkg:DefensiveAction a owl:Class ;
    rdfs:label "Defensive Action"@en ;
    rdfs:subClassOf footkg:MatchEvent .

footkg:DirectVertical a owl:Class ;
    rdfs:label "Direct Vertical Transition"@en ;
    rdfs:subClassOf footkg:TacticalSystem .

footkg:FalseNine a owl:Class ;
    rdfs:label "False Nine"@en ;
    rdfs:subClassOf footkg:AttackingRole .

footkg:Gegenpressing a owl:Class ;
    rdfs:label "Gegenpressing (Counter-pressing)"@en ;
    rdfs:subClassOf footkg:TacticalSystem .

footkg:InsideForward a owl:Class ;
    rdfs:label "Inside Forward"@en ;
    rdfs:subClassOf footkg:WideRole .

footkg:InvertedFullback a owl:Class ;
    rdfs:label "Inverted Fullback"@en ;
    rdfs:subClassOf footkg:WideRole .

footkg:LowBlockCounter a owl:Class ;
    rdfs:label "Low-Block Counter-Attack"@en ;
    rdfs:subClassOf footkg:TacticalSystem .

footkg:Mezzala a owl:Class ;
    rdfs:label "Mezzala (Half-space Midfielder)"@en ;
    rdfs:subClassOf footkg:MidfieldRole .

footkg:OverlappingWingback a owl:Class ;
    rdfs:label "Overlapping Wingback"@en ;
    rdfs:subClassOf footkg:WideRole .

footkg:PositionalPlay a owl:Class ;
    rdfs:label "Positional Play (Juego de Posicion)"@en ;
    rdfs:subClassOf footkg:TacticalSystem .

footkg:PressingForward a owl:Class ;
    rdfs:label "Pressing Forward"@en ;
    rdfs:subClassOf footkg:AttackingRole .

footkg:Raumdeuter a owl:Class ;
    rdfs:label "Raumdeuter (Space Investigator)"@en ;
    rdfs:subClassOf footkg:AttackingRole .

footkg:Relationism a owl:Class ;
    rdfs:label "Relationism (Appariement)"@en ;
    rdfs:subClassOf footkg:TacticalSystem .

footkg:TouchlineWinger a owl:Class ;
    rdfs:label "Touchline Winger"@en ;
    rdfs:subClassOf footkg:WideRole .

footres:Club_Benfica a footkg:ClubTeam ;
    rdfs:label "SL Benfica"@en ;
    footkg:managedBy footres:Manager_RogerSchmidt .

footres:Club_Brighton a footkg:ClubTeam ;
