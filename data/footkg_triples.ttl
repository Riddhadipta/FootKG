@prefix footkg: <http://tib.eu/footkg/ontology#> .
@prefix footres: <http://tib.eu/footkg/resource/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://tib.eu/footkg/ontology> a owl:Ontology ;
    rdfs:label "FootKG: Tactical Football & Scouting Ontology"@en ;
    rdfs:comment "An ontology for multi-hop tactical reasoning, player role taxonomy, spatial pitch dynamics, and intelligent scouting."@en ;
    owl:versionInfo "1.0.0" .

footkg:Competition a owl:Class ;
    rdfs:label "Football Competition"@en .

footkg:Match a owl:Class ;
    rdfs:label "Football Match"@en .

footkg:NationalTeam a owl:Class ;
    rdfs:label "National Team"@en ;
    rdfs:subClassOf footkg:Team .

footkg:Pressure a owl:Class ;
    rdfs:label "Pressure Action"@en ;
    rdfs:subClassOf footkg:DefensiveAction .

footkg:SweeperKeeper a owl:Class ;
    rdfs:label "Sweeper Keeper"@en ;
    rdfs:subClassOf footkg:DefensiveRole .

footkg:TargetMan a owl:Class ;
    rdfs:label "Target Man"@en ;
    rdfs:subClassOf footkg:AttackingRole .

footkg:adjacentTo a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "is spatially adjacent to"@en ;
    rdfs:domain footkg:SpatialZone ;
    rdfs:range footkg:SpatialZone .

footkg:age a owl:DatatypeProperty ;
    rdfs:domain footkg:Player ;
    rdfs:range xsd:integer .

footkg:coachedBy a owl:ObjectProperty ;
    rdfs:label "has been coached by"@en ;
    rdfs:domain footkg:Player ;
    rdfs:range footkg:Manager .

footkg:contractUntil a owl:DatatypeProperty ;
    rdfs:domain footkg:Player ;
    rdfs:range xsd:gYear .

footkg:directlyPrecedes a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "directly precedes event in chain"@en ;
    rdfs:domain footkg:MatchEvent ;
    rdfs:range footkg:MatchEvent .

footkg:employsSystem a owl:ObjectProperty ;
    rdfs:label "employs tactical system"@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( footkg:Manager footkg:Team ) ] ;
    rdfs:range footkg:TacticalSystem .

footkg:exploitsWeaknessIn a owl:ObjectProperty ;
    rdfs:label "exploits structural weakness in"@en ;
    rdfs:domain footkg:Formation ;
    rdfs:range footkg:Formation .

footkg:formerlyPlayedFor a owl:ObjectProperty ;
    rdfs:label "formerly played for"@en ;
    rdfs:domain footkg:Player ;
    rdfs:range footkg:Team .

footkg:hasChemistryWith a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "shares high team chemistry with"@en ;
    rdfs:domain footkg:Player ;
    rdfs:range footkg:Player .

footkg:inPossessionZone a owl:ObjectProperty ;
    rdfs:label "operates in zone when in possession"@en ;
    rdfs:subPropertyOf footkg:operatesInZone .

footkg:leavesVulnerableZone a owl:ObjectProperty ;
    rdfs:label "leaves zone vulnerable during transition"@en ;
    rdfs:domain footkg:Formation ;
    rdfs:range footkg:SpatialZone .

footkg:managedBy a owl:ObjectProperty ;
    rdfs:label "managed by"@en ;
    rdfs:domain footkg:Team ;
    rdfs:range footkg:Manager .

footkg:marketValueEUR a owl:DatatypeProperty ;
    rdfs:domain footkg:Player ;
    rdfs:range xsd:decimal .

footkg:nationality a owl:DatatypeProperty ;
    rdfs:domain footkg:Person ;
    rdfs:range xsd:string .

footkg:originatesInZone a owl:ObjectProperty ;
    rdfs:label "originates in zone"@en ;
    rdfs:domain footkg:MatchEvent ;
    rdfs:range footkg:SpatialZone .

footkg:outOfPossessionZone a owl:ObjectProperty ;
    rdfs:label "operates in zone when out of possession"@en ;
    rdfs:subPropertyOf footkg:operatesInZone .

footkg:passCompletionPct a owl:DatatypeProperty ;
    rdfs:domain footkg:Player ;
    rdfs:range xsd:float .

footkg:performedBy a owl:ObjectProperty ;
    rdfs:label "performed by player"@en ;
    rdfs:domain footkg:MatchEvent ;
    rdfs:range footkg:Player .

footkg:playerName a owl:DatatypeProperty ;
    rdfs:domain footkg:Person ;
    rdfs:range xsd:string .

footkg:playsFor a owl:ObjectProperty ;
    rdfs:label "plays for team"@en ;
    rdfs:domain footkg:Player ;
    rdfs:range footkg:Team .

footkg:preferredFoot a owl:DatatypeProperty ;
    rdfs:domain footkg:Player ;
    rdfs:range xsd:string .

footkg:pressuresPer90 a owl:DatatypeProperty ;
    rdfs:domain footkg:Player ;
    rdfs:range xsd:float .

footkg:primaryRole a owl:ObjectProperty ;
    rdfs:label "primary tactical role"@en ;
    rdfs:subPropertyOf footkg:playsRole .

footkg:progressivePassesPer90 a owl:DatatypeProperty ;
    rdfs:domain footkg:Player ;
    rdfs:range xsd:float .

footkg:secondaryRole a owl:ObjectProperty ;
    rdfs:label "secondary tactical role"@en ;
    rdfs:subPropertyOf footkg:playsRole .

footkg:synergizesWith a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "synergizes tactically with"@en ;
    rdfs:domain footkg:TacticalRole ;
    rdfs:range footkg:TacticalRole .

footkg:terminatesInZone a owl:ObjectProperty ;
    rdfs:label "terminates in zone"@en ;
    rdfs:domain footkg:MatchEvent ;
    rdfs:range footkg:SpatialZone .

footkg:transitionsToInPossession a owl:ObjectProperty ;
    rdfs:label "transitions in possession to"@en ;
    rdfs:domain footkg:Formation ;
    rdfs:range footkg:Formation .

footkg:utilizesFormation a owl:ObjectProperty ;
    rdfs:label "utilizes formation"@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( footkg:Team footkg:TacticalSystem ) ] ;
    rdfs:range footkg:Formation .

footkg:xAPer90 a owl:DatatypeProperty ;
    rdfs:domain footkg:Player ;
    rdfs:range xsd:float .

footkg:xGPer90 a owl:DatatypeProperty ;
    rdfs:domain footkg:Player ;
    rdfs:range xsd:float .

footkg:zoneDescription a owl:DatatypeProperty ;
    rdfs:domain footkg:SpatialZone ;
    rdfs:range xsd:string .

footres:Club_InterMilan a footkg:ClubTeam ;
    rdfs:label "FC Internazionale Milano"@en ;
    footkg:managedBy footres:Manager_SimoneInzaghi .

footres:Club_Liverpool a footkg:ClubTeam ;
    rdfs:label "Liverpool FC"@en ;
    footkg:managedBy footres:Manager_ArneSlot .

footres:Event_001_Rodri_BallRecovery a footkg:BallRecovery ;
    footkg:directlyPrecedes footres:Event_002_Rodri_ProgressivePass ;
    footkg:originatesInZone footres:Zone3_DefCentral ;
    footkg:performedBy footres:Player_Rodri ;
    footkg:terminatesInZone footres:Zone8_MidCentral .

footres:Formation_5_3_2_Counter a footkg:Formation ;
    rdfs:label "5-3-2 Direct Counter"@en ;
    footkg:exploitsWeaknessIn footres:Formation_4_3_3 ;
    footkg:leavesVulnerableZone footres:Zone11_AttRightFlank,
        footres:Zone15_AttLeftFlank .

footres:Manager_JurgenKlopp a footkg:Manager ;
    rdfs:label "Jurgen Klopp"@en ;
    footkg:employsSystem footres:System_Gegenpressing ;
    footkg:nationality "Germany"^^xsd:string ;
    footkg:utilizesFormation footres:Formation_4_3_3 .

